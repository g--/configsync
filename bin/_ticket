#!/bin/bash

# Resolve the issue identifier for the current directory.
#
# Preference order:
#   1. The branch prefix, when on an ISSUE/description branch.
#   2. The nearest .ticket file found by walking up from $PWD. This lets a
#      ticket root and each workspace below it share one identifier.

if branch=$(git symbolic-ref --short HEAD 2>/dev/null); then
  :
else
  branch=""
fi

if [[ "$branch" == */* ]]; then
  printf '%s' "${branch%%/*}"
  exit 0
fi

dir="$PWD"
while [[ -n "$dir" ]]; do
  if [[ -f "$dir/.ticket" ]]; then
    cat "$dir/.ticket"
    exit 0
  fi
  [[ "$dir" == "/" ]] && break
  dir="$(dirname "$dir")"
done
